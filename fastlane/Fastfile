# Fastfile — automation for building and shipping RoundPlay.
# Run a lane with:  bundle exec fastlane <lane>
# Docs: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # RoundPlay.xcodeproj is generated from project.yml via xcodegen, not
    # checked into git — regenerate it first so the archive reflects the
    # current source tree.
    sh("xcodegen generate")

    # Every TestFlight upload needs a unique build number, otherwise Apple
    # rejects it. A timestamp (YYYYMMDDHHMM) guarantees uniqueness with no
    # network calls — simple and reliable for getting started.
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "RoundPlay.xcodeproj"
    )

    # Archive + export a signed .ipa for the App Store.
    # -allowProvisioningUpdates lets Xcode manage signing for the app
    # automatically.
    build_app(
      scheme: "RoundPlay",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    # Upload the build to TestFlight.
    # skip_waiting_for_build_processing: true returns as soon as the upload
    # finishes instead of waiting ~10+ min for Apple to finish processing.
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
